# ============================================================
# FASHIONA E-COMMERCE — .gitignore
# Covers: Spring Boot · React / Vite · React Native · macOS
# ============================================================

# ── macOS ────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ── IDE / Editors ────────────────────────────────────────────
.idea/
*.iml
.vscode/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Environment / Secrets ────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets.yml

# ============================================================
# BACKEND — Spring Boot / Maven
# ============================================================
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
!backend/.mvn/wrapper/maven-wrapper.properties
!backend/.mvn/jvm.config
backend/*.log

# ── Java compiled output ─────────────────────────────────────
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# ============================================================
# FRONTEND — React / Vite / Node
# ============================================================
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
frontend/.eslintcache

# ── npm / yarn / pnpm ────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp
.pnp.js
.yarn/install-state.gz

# ============================================================
# MOBILE — React Native
# ============================================================
mobile/node_modules/
mobile/.gradle/
mobile/android/app/build/
mobile/android/build/
mobile/android/.navigation/
mobile/android/local.properties
mobile/android/captures/
mobile/android/*.keystore
!mobile/android/debug.keystore
mobile/android/.cxx/

mobile/ios/build/
mobile/ios/Pods/
mobile/ios/*.xcworkspace/xcuserdata/
mobile/ios/DerivedData/
mobile/ios/*.hmap
mobile/ios/*.ipa
mobile/.xcode.env.local

mobile/coverage/
mobile/vendor/bundle/

# ── Metro bundler cache ──────────────────────────────────────
.metro-health-check*
mobile/.metro-bundler-cache*/

# ============================================================
# LOGS & MISC
# ============================================================
*.log
logs/
*.tmp
*.temp
Thumbs.db
.vercel
