# Copy this file to .env.prod and fill in your real values
# Never commit .env.prod to git!

# Aurora PostgreSQL (use ?ssl=true&sslmode=require for Aurora)
DB_URL=jdbc:postgresql://database-1.cluster-cxqusas6k83t.ap-south-1.rds.amazonaws.com:5432/fashiondb?ssl=true&sslmode=require
DB_USER=postgres
DB_PASSWORD=your-aurora-master-password

# Generate a secure random string (64+ chars) for JWT signing
# You can run: openssl rand -base64 64
JWT_SECRET=replace-this-with-a-very-long-random-string-at-least-64-characters
